#!/usr/bin/env bash
# cage — Claude Code in a bubblewrap filesystem sandbox. Host network is shared.
#
#   cage                     profile from $PWD
#   cage <profile> [args]    force a profile
#   CAGE_OFF=1 cage          no sandbox
#
# Profiles are the ~/.claude-<name> dirs; "main" is personal and reaches
# everything but the secrets below. A customer profile is confined to its tree
# under $CUSTOMERS (matched by name prefix) plus its own config dir.

set -euo pipefail

CLAUDE_BIN=/usr/bin/claude

die() {
	printf 'cage: %s\n' "$1" >&2
	exit 1
}

profile_names() {
	local d
	for d in "$HOME"/.claude-*/; do
		[[ -d "$d" ]] || continue
		d="${d%/}"
		printf '%s\n' "${d##*/.claude-}"
	done
}

customer_root() {
	local prof="${1,,}" d base matches=()
	[[ ${CUSTOMERS-} && -d ${CUSTOMERS-} ]] || return 1
	for d in "$CUSTOMERS"/*/; do
		d="${d%/}"
		base="${d##*/}"
		[[ "${base,,}" == "$prof"* ]] && matches+=("$d")
	done
	((${#matches[@]} == 1)) || return 1
	printf '%s\n' "${matches[0]}"
}

resolve_profile() {
	local name root
	[[ ${CUSTOMERS-} && "$PWD" == "$CUSTOMERS"/* ]] || {
		printf 'main\n'
		return
	}
	while read -r name; do
		[[ $name == main ]] && continue
		root="$(customer_root "$name")" || continue
		[[ "$PWD" == "$root"* ]] && {
			printf '%s\n' "$name"
			return
		}
	done < <(profile_names)
	printf 'main\n'
}

# A bare first argument is a profile only if it names one; anything else is a
# prompt and belongs to Claude.
if [[ ${1-} && ${1-} != -* && -d "$HOME/.claude-${1}" ]]; then
	profile="$1"
	shift
else
	profile="$(resolve_profile)"
fi

cfg="$HOME/.claude-$profile"
[[ -d "$cfg" ]] || die "profile '$profile' has no config dir at $cfg"

if [[ ${CAGE_OFF-} ]]; then
	exec env CLAUDE_CONFIG_DIR="$cfg" "$CLAUDE_BIN" "$@"
fi

base=(
	--ro-bind /usr /usr
	--ro-bind /etc /etc
	--ro-bind /opt /opt

	# bwrap's userns maps host root→nobody(65534), so every Include'd ssh
	# drop-in looks unowned and ssh aborts: "Bad owner or permissions on
	# /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf", killing git-over-ssh.
	# Blank the dir so the Include glob in /etc/ssh/ssh_config matches nothing
	# (those systemd/libvirt proxy drop-ins are useless in here anyway); the
	# top-level config isn't perm-checked, so it still loads.
	--tmpfs /etc/ssh/ssh_config.d
	--symlink usr/bin /bin
	--symlink usr/lib /lib
	--symlink usr/lib64 /lib64
	--symlink usr/sbin /sbin
	--proc /proc
	--dev /dev
	# host /tmp shared in: lets the harness scratchpad (/tmp/claude-*) persist
	# and be visible on the host. Accepted local-reach tradeoff (all profiles).
	--bind /tmp /tmp

	# wipes docker.sock, the D-Bus socket and the keyring
	--tmpfs /run
	# /etc/resolv.conf symlinks in here; without it there is no DNS
	--ro-bind /run/systemd/resolve /run/systemd/resolve

	--ro-bind /sys /sys
	--tmpfs /sys/firmware
	--tmpfs /sys/kernel/security

	--unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup
	--hostname cage
	--die-with-parent
)

# node/npm live under /run and symlink into a store in $HOME; both halves needed
if [[ ${FNM_MULTISHELL_PATH-} ]]; then
	base+=(--ro-bind-try "$FNM_MULTISHELL_PATH" "$FNM_MULTISHELL_PATH")
fi

# no SSH agent is forwarded: signing keys stay out of reach, push/pull is manual
base+=(--unsetenv SSH_AUTH_SOCK)

run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [[ $profile == main ]]; then
	layers=(--bind "$HOME" "$HOME")
	for d in .ssh .gnupg .aws .local/share/keyrings \
		.1password .config/1Password .config/BraveSoftware .config/Bitwarden; do
		layers+=(--tmpfs "$HOME/$d")
	done

	# hyprctl talks over this; --tmpfs /run took it away. Only the personal
	# profile edits the desktop config, so only it gets the socket back.
	layers+=(--ro-bind-try "$run/hypr" "$run/hypr")

	# System logs, for debugging this machine (GPU hangs, crashes, pacman).
	# Read-only, and main only — a customer session has no business reading
	# the host's logs. /run/log is the volatile journal (empty when journald
	# storage is persistent), /var/log the persistent one.
	# NOTE: this exposes the *files*; whether journalctl can parse them is a
	# permissions question. $USER reads the system journal through the wheel
	# group ACL, and bwrap's userns maps every supplementary group to nobody,
	# so system.journal stays unreadable in here unless the journal dir also
	# carries a uid-based ACL (setfacl -m d:u:$USER:r,u:$USER:r on it). The user
	# journal (ACL'd by uid) and root-readable logs like pacman.log work.
	layers+=(--ro-bind-try /var/log /var/log)
	layers+=(--ro-bind-try /run/log /run/log)

	workdir="$PWD"
else
	root="$(customer_root "$profile")" ||
		die "profile '$profile' matches no single directory under \$CUSTOMERS"

	layers=(
		--tmpfs "$HOME"
		--bind "$root" "$root"
		--bind "$cfg" "$cfg"
		--ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig"
		--ro-bind-try "$HOME/.kube" "$HOME/.kube"
		--ro-bind-try "$HOME/.local/share/fnm" "$HOME/.local/share/fnm"
		--bind-try "$HOME/.config/gcloud" "$HOME/.config/gcloud"
		--bind-try "$HOME/.config/glab-cli" "$HOME/.config/glab-cli"
	)

	workdir="$root"
	[[ "$PWD" == "$root"* ]] && workdir="$PWD"
fi

# Every profile needs this one: pasting an image shells out to wl-paste, which
# talks to the compositor. The name comes from the session, so a Plasma
# wayland-0 works like a Hyprland wayland-1. Screencopy rides the same socket,
# so a caged session can capture the screen — accepted, it is the price of
# Ctrl+V. D-Bus stays out, so the keyrings remain unreachable.
if [[ ${WAYLAND_DISPLAY-} == /* ]]; then
	layers+=(--ro-bind-try "$WAYLAND_DISPLAY" "$WAYLAND_DISPLAY")
elif [[ ${WAYLAND_DISPLAY-} ]]; then
	layers+=(--ro-bind-try "$run/$WAYLAND_DISPLAY" "$run/$WAYLAND_DISPLAY")
fi

# Browsers can't run in the jail (namespaced PIDs make Chromium treat the host
# SingletonLock as stale). xdg-open/brave/firefox become a stub writing the URL
# to a FIFO; a host-side loop hands it to the running browser and exits with
# bwrap (exec keeps our PID). Lives under /tmp/claude so the per-command Bash
# sandbox can write to it too.
mkdir -p -m 700 /tmp/claude
bridge=$(mktemp -d /tmp/claude/cage-open.XXXXXX)
mkfifo "$bridge/fifo"
printf '#!/bin/sh\nfor u; do :; done\necho "${0##*/} $u" >"$CAGE_OPEN_FIFO"\n' >"$bridge/open"
chmod +x "$bridge/open"
(
	exec 3<>"$bridge/fifo"
	while kill -0 $$ 2>/dev/null; do
		read -r -t 2 -u 3 b url || continue
		[[ $url =~ ^https?://[^[:space:]]+$ ]] || continue
		case $b in
		brave | firefox) "$b" "$url" ;;
		# same per-tmux-session pick as prefix+u (main→firefox, else brave)
		*) ~/.local/bin/tmux-browser "$url" ;;
		esac &
	done
	rm -rf "$bridge"
) &>/dev/null &
for b in xdg-open brave firefox; do
	layers+=(--ro-bind "$bridge/open" "/usr/bin/$b")
done
layers+=(--setenv CAGE_OPEN_FIFO "$bridge/fifo" --setenv BROWSER xdg-open)

# glab's token lives in the OS keyring, which --tmpfs /run makes unreachable
# inside the jail (D-Bus socket gone). Rather than bind the bus back — which
# would expose the *whole* keyring to a customer session — the token is stored
# as plaintext under its host in ~/.config/glab-cli/config.yml (use_keyring
# false). That file is already bound in, so glab authenticates from it.

# Private Go modules (`go mod download`) clone from a customer git host over
# SSH. The usual auth key lives in the 1Password agent, which cannot cross a
# bwrap namespace (proven, not a missing bind), so cloning uses dedicated
# on-disk keys at ~/.ssh/cage_<profile> — generated with no passphrase, .pub
# registered on the git host. A customer profile gets only its own key; the
# personal profile offers every cage_* key it has (each host accepts its own),
# so main can clone the same customer hosts. Only these keys (read-only) plus
# known_hosts are exposed — the agent and all other keys stay out.
# GIT_SSH_COMMAND forces them with IdentitiesOnly (no agent lookup); the host
# gitconfig's HTTPS→SSH rewrite is kept so HTTPS clone URLs resolve to SSH.
# Commit signing (1Password op-ssh-sign) still won't work in the jail.
ssh_keys=()
if [[ $profile == main ]]; then
	for k in "$HOME"/.ssh/cage_*; do
		[[ -f $k && $k != *.pub ]] && ssh_keys+=("$k")
	done
else
	[[ -f "$HOME/.ssh/cage_$profile" ]] && ssh_keys+=("$HOME/.ssh/cage_$profile")
fi
if ((${#ssh_keys[@]})); then
	ssh_cmd="ssh -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
	for k in "${ssh_keys[@]}"; do
		layers+=(--ro-bind "$k" "$k")
		ssh_cmd+=" -i $k"
	done
	layers+=(--ro-bind-try "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts")
	layers+=(--setenv GIT_SSH_COMMAND "$ssh_cmd")
	unset ssh_cmd
fi
unset ssh_keys k

# Claude reads and writes everything (settings.local.json included) under
# CLAUDE_CONFIG_DIR, so nothing here touches ~/.claude — it must never exist.
exec bwrap "${base[@]}" "${layers[@]}" \
	--setenv CLAUDE_CONFIG_DIR "$cfg" \
	--chdir "$workdir" \
	"$CLAUDE_BIN" "$@"
